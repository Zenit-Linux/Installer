<?xml version="1.0" encoding="UTF-8"?>
<!-- Zenit Linux – Openbox dla sesji instalatora: brak menu i skrótów, okna na cały ekran -->
<openbox_config xmlns="http://openbox.org/3.4/rc">
  <focus><focusNew>yes</focusNew><followMouse>no</followMouse></focus>
  <desktops><number>1</number></desktops>
  <keyboard/>
  <mouse/>
  <applications>
    <application class="calamares">
      <fullscreen>yes</fullscreen><decor>no</decor><focus>yes</focus><layer>above</layer>
    </application>
    <application name="calamares">
      <fullscreen>yes</fullscreen><decor>no</decor>
    </application>
    <application title="zenit-live-chooser">
      <fullscreen>yes</fullscreen><decor>no</decor>
    </application>
    <application class="Nm-connection-editor">
      <decor>yes</decor><layer>above</layer><position force="no"><x>center</x><y>center</y></position>
    </application>
  </applications>
</openbox_config>
