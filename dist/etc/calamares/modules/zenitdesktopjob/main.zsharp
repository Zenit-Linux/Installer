#!/usr/bin/zsi
# Zenit Linux – instaluje wybrane środowiska graficzne w docelowym systemie (zypper)
# i konfiguruje display manager. Wybór pochodzi z ekranu QML (Global Storage: zenit_desktops).
#
# Uruchamiany przez mostek main.py (Calamares ładuje moduły job tylko przez interfejs Pythona):
#   /usr/bin/zsi main.zsharp
# Wejście (zmienne środowiska ustawia mostek):
#   ZENIT_ROOT      punkt montowania docelowego systemu (rootMountPoint)
#   ZENIT_DESKTOPS  lista id środowisk rozdzielona przecinkami (zenit_desktops)
#   ZENIT_JOB_DIR   katalog modułu (z desktops.json)
# Wyjście (stdout, linie z prefiksem "@@zenit@@ "):
#   PROGRESS <0..1>               postęp
#   ERROR<TAB>tytuł<TAB>opis      błąd – mostek zwraca go Calamaresowi; kod wyjścia 1
import Std.Os;
import Std.Json;
import Std.Path;

# 100-103: sukces z uwagami (restart, nowe repo itp.)
func zypperOk() { return [0, 100, 101, 102, 103]; }
func mark() { return "@@zenit@@ "; }

func progress($x) { echo mark() . "PROGRESS " . $x; return null; }

func fail($title, $msg) {
    echo mark() . "ERROR\t" . $title . "\t" . $msg;
    return 1;
}

func warning($msg) { eecho("WARNING: " . $msg); return null; }
func debug($msg) { eecho("DEBUG: " . $msg); return null; }

##
 * Wywołanie polecenia w chroocie docelowego systemu (odpowiednik target_env_call);
 * zwraca kod wyjścia, wyjście jest dziedziczone.
##
func targetCall($root, $cmd) {
    $a = [$root];
    foreach ($cmd as $x) { $a[] = $x; }
    return Os.exec("chroot", $a);
}

# Czyta /etc/zenit/distro.conf (linie NAZWA="wartość") do tablicy asocjacyjnej.
func readDistroConf($path = "/etc/zenit/distro.conf") {
    $conf = [];
    if (!Os.isFile($path)) {
        warning("Brak " . $path . " – zakładam BASE=tumbleweed");
        return $conf;
    }
    foreach (Os.readLines($path) as $raw) {
        $ln = trim($raw);
        $eq = index_of($ln, "=");
        if ($ln === "" || starts_with($ln, "#") || $eq <= 0) { continue; }
        $name = substr($ln, 0, $eq);
        $ok = true;
        foreach (chars($name) as $c) {
            if (!($c === "_" || (is_alpha($c) && $c === upper($c)))) { $ok = false; }
        }
        if (!$ok) { continue; }
        $val = trim(substr($ln, $eq + 1));
        if (strlen($val) > 0 && substr($val, 0, 1) === "\"") { $val = substr($val, 1); }
        if (strlen($val) > 0 && substr($val, strlen($val) - 1, 1) === "\"") { $val = substr($val, 0, strlen($val) - 1); }
        $conf[$name] = $val;
    }
    return $conf;
}

func zypperInstall($root, $pkgs, $recommends = false) {
    if (count($pkgs) === 0) { return 0; }
    $cmd = ["zypper", "--non-interactive", "install", "--auto-agree-with-licenses", "--ignore-unknown"];
    if (!$recommends) { $cmd[] = "--no-recommends"; }
    foreach ($pkgs as $p) { $cmd[] = $p; }
    $rc = targetCall($root, $cmd);
    if (!in_array($rc, zypperOk())) {
        warning("zypper zwrócił " . $rc . " dla: " . join($pkgs, " "));
    }
    return $rc;
}

func configureDisplayManager($root, $dm) {
    # openSUSE: alternatywa + sysconfig + unit display-manager.service
    targetCall($root, ["update-alternatives", "--set", "default-displaymanager",
                       "/usr/lib/X11/displaymanagers/" . $dm]);
    $path = $root . "/etc/sysconfig/displaymanager";
    try {
        $lines = Os.isFile($path) ? Os.readLines($path) : [];
        $found = false;
        $out = [];
        foreach ($lines as $ln) {
            if (starts_with($ln, "DISPLAYMANAGER=")) {
                $out[] = "DISPLAYMANAGER=\"" . $dm . "\"";
                $found = true;
            } else {
                $out[] = $ln;
            }
        }
        if (!$found) { $out[] = ""; $out[] = "DISPLAYMANAGER=\"" . $dm . "\""; }
        Os.mkdir(Path.dirname($path));
        Os.writeFile($path, join($out, "\n") . "\n");
    } catch (Exception $e) {
        warning("Nie udało się zapisać " . $path . ": " . $e->getMessage());
    }
    if (targetCall($root, ["systemctl", "enable", "display-manager.service"]) !== 0) {
        targetCall($root, ["systemctl", "enable", $dm . ".service"]);
    }
    return null;
}

func main() {
    $root = Os.env("ZENIT_ROOT", "");
    $jobDir = Os.env("ZENIT_JOB_DIR", Path.dirname(Path.absolute(System.args()[0])));
    if ($root === "") { return fail("Błąd konfiguracji", "Brak ZENIT_ROOT (rootMountPoint)."); }

    $wanted = [];
    foreach (split(Os.env("ZENIT_DESKTOPS", "plasma"), ",") as $x) {
        if ($x !== "") { $wanted[] = $x; }
    }
    if (count($wanted) === 0) { $wanted = ["plasma"]; }

    $data = Json.decode(Os.readFile($jobDir . "/desktops.json"));
    $catalogue = [];
    foreach ($data["desktops"] as $d) { $catalogue[$d["id"]] = $d; }
    $conf = readDistroConf();
    $base = $conf["BASE"] ?? "tumbleweed";

    $chosen = [];
    foreach ($wanted as $did) {
        $d = $catalogue[$did] ?? null;
        if ($d === null || ($d["placeholder"] ?? false)) {
            warning("Pomijam " . $did . " (nieznane lub placeholder)");
            continue;
        }
        $bases = $d["bases"] ?? null;
        if ($bases !== null && count($bases) > 0 && !in_array($base, $bases)) {
            warning("Pomijam " . $did . " – niedostępne w bazie " . $base);
            continue;
        }
        $chosen[] = $d;
    }
    if (count($chosen) === 0) {
        return fail("Brak środowiska graficznego",
                    "Nie wybrano żadnego dostępnego środowiska graficznego dla bazy " . $base . ".");
    }

    # DNS wewnątrz chroota (zypper potrzebuje internetu)
    try {
        Os.writeFile($root . "/etc/resolv.conf", Os.readFile("/etc/resolv.conf"));
    } catch (Exception $e) {
        warning("resolv.conf: " . $e->getMessage());
    }

    progress(0.02);
    targetCall($root, ["zypper", "--non-interactive", "refresh"]);

    # Wspólne pakiety dla typów sesji
    $types = "";
    foreach ($chosen as $d) { $types .= " " . $d["type"]; }
    $common = [];
    if (contains($types, "X11")) { foreach ($data["common"]["x11"] as $p) { $common[] = $p; } }
    if (contains($types, "Wayland")) { foreach ($data["common"]["wayland"] as $p) { $common[] = $p; } }
    zypperInstall($root, $common);

    $n = count($chosen);
    for ($i = 0; $i < $n; $i++) {
        $d = $chosen[$i];
        debug("Instaluję środowisko: " . $d["name"]);
        $rc = zypperInstall($root, $d["packages"], boolval($d["recommends"] ?? false));
        if (!in_array($rc, zypperOk()) && $i === 0) {
            return fail("Błąd instalacji środowiska " . $d["name"],
                        "zypper zakończył się kodem " . $rc . ". Sprawdź połączenie z internetem i repozytoria.");
        }
        progress(0.05 + 0.85 * ($i + 1) / $n);
    }

    $primary = $chosen[0];
    $dm = $primary["dm"] ?? "sddm";
    zypperInstall($root, $data["dm_packages"][$dm] ?? [$dm]);
    configureDisplayManager($root, $dm);

    # Zapamiętaj wybór (informacyjnie)
    Os.mkdir($root . "/etc/zenit");
    $ids = [];
    foreach ($chosen as $d) { $ids[] = $d["id"]; }
    Os.writeFile($root . "/etc/zenit/desktops",
        "# Środowiska wybrane podczas instalacji (pierwsze = domyślne)\n" . join($ids, "\n") . "\n");

    progress(1.0);
    return 0;
}

exit(main());
