#!/usr/bin/zsi
# Zenit Linux – pełnoekranowy ekran startowy live: Instalacja / Tryb live.
# Na stdout wypisuje: install | live | reboot | poweroff.  Wymaga pakietu yad (GTK).
# Okno ma tytuł "zenit-live-chooser" – dopasowuje je reguła w /etc/zenit/openbox/rc.xml.
import Std.Os;

func readDistroConf($path = "/etc/zenit/distro.conf") {
    $conf = [];
    if (!Os.isFile($path)) { return $conf; }
    foreach (Os.readLines($path) as $raw) {
        $ln = trim($raw);
        $eq = index_of($ln, "=");
        if ($ln === "" || starts_with($ln, "#") || $eq <= 0) { continue; }
        $val = trim(substr($ln, $eq + 1));
        if (strlen($val) > 0 && substr($val, 0, 1) === "\"") { $val = substr($val, 1); }
        if (strlen($val) > 0 && substr($val, strlen($val) - 1, 1) === "\"") { $val = substr($val, 0, strlen($val) - 1); }
        $conf[substr($ln, 0, $eq)] = $val;
    }
    return $conf;
}

func main() {
    $logo = "/usr/share/zenit/logo-dark.png";
    $name = readDistroConf()["DISTRO_NAME"] ?? "Zenit Linux";
    $args = [
        "--title", "zenit-live-chooser",
        "--fullscreen", "--center", "--no-escape",
        "--text-align", "center", "--buttons-layout", "center",
        "--text", "<span size='xx-large' weight='bold' foreground='#D4A93A'>" . $name . "</span>\n<span foreground='#A99C74'>Co chcesz zrobić?</span>",
        "--button", "Zainstaluj:10",
        "--button", "Wypróbuj (tryb live):20"
    ];
    if (Os.which("nm-connection-editor") !== null) {
        $args[] = "--button";
        $args[] = "Sieć / Wi-Fi:nm-connection-editor";
    }
    $args[] = "--button"; $args[] = "Uruchom ponownie:30";
    $args[] = "--button"; $args[] = "Wyłącz:40";
    if (Os.isFile($logo)) { $args[] = "--image"; $args[] = $logo; $args[] = "--image-on-top"; }

    $rc = -1;
    try { $rc = Os.run("yad", $args)["status"]; }
    catch (Exception $e) { eecho("zenit-live-chooser: brak yad (" . $e->getMessage() . ")"); }

    $map = [10 => "install", 20 => "live", 30 => "reboot", 40 => "poweroff"];
    $out = $map[$rc] ?? "";
    echo $out;
    return 0;
}

exit(main());
