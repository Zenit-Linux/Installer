#!/usr/bin/zsi
# Instaluje wynik build.zsharp do systemu/rootfs:  sudo DESTDIR=/ścieżka/do/rootfs ./install.zsharp
import Std.Os;
import Std.Path;

func main() {
    $dir = Path.dirname(Path.absolute(System.args()[0]));
    Os.chdir($dir);
    if (!Os.isDir("dist")) {
        $code = Os.exec("zsi", [$dir . "/build.zsharp"]);
        if ($code !== 0) { eecho("BŁĄD: build.zsharp zakończył się kodem " . $code); return $code; }
    }
    $dest = Os.env("DESTDIR", "/");
    $code = Os.exec("cp", ["-a", "dist/.", $dest . "/"]);
    if ($code !== 0) { eecho("BŁĄD: kopiowanie do " . $dest . " nie powiodło się"); return $code; }
    echo "Zainstalowano do " . $dest;
    echo "Wymagane pakiety w obrazie: calamares python3-PyYAML python3-qt5 openbox sddm sudo xsetroot NetworkManager-applet (opcj.) zsi";
    return 0;
}

exit(main());
